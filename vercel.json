{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "includeFiles": "static/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/fastapi" }
  ],
  "env": {
    "PUBLIC_DEMO": "true",
    "EMBEDDING_BACKEND": "hashed",
    "USER_AGENT": "Brahma/0.1 (https://github.com/vedantt17/Brahma/issues)"
  }
}
